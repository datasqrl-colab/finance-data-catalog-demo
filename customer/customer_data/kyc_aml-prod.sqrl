-- ## KYC and AML Compliance Data - Production
--
-- Ingests source data from Kafka

IMPORT kyc_aml.*;

CREATE TABLE Kyc_Verification (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${CUSTOMER_DATA_KAFKA_BROKERS}',
    'topic' = 'kyc_aml.kyc_verification',
    'scan.startup.mode' = 'earliest-offset',
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Kyc_Verification_schema;

CREATE TABLE Sanctions_Screening (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${CUSTOMER_DATA_KAFKA_BROKERS}',
    'topic' = 'kyc_aml.sanctions_screening',
    'scan.startup.mode' = 'earliest-offset',
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Sanctions_Screening_schema;

CREATE TABLE Pep_Screening (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${CUSTOMER_DATA_KAFKA_BROKERS}',
    'topic' = 'kyc_aml.pep_screening',
    'scan.startup.mode' = 'earliest-offset',
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Pep_Screening_schema;

CREATE TABLE Customer_Risk_Rating (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp'
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${CUSTOMER_DATA_KAFKA_BROKERS}',
    'topic' = 'kyc_aml.customer_risk_rating',
    'scan.startup.mode' = 'earliest-offset',
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Risk_Rating_schema;
