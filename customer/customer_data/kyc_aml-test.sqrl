-- ## KYC and AML Compliance Data - Test Data
--
-- Use local filesystem data for testing

IMPORT kyc_aml.*;

CREATE TABLE _Kyc_Verification_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/kyc_aml-kyc_verification.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Kyc_Verification_schema;

Kyc_Verification := SELECT * FROM _Kyc_Verification_input WHERE verification_id <> '';

CREATE TABLE _Sanctions_Screening_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/kyc_aml-sanctions_screening.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Sanctions_Screening_schema;

Sanctions_Screening := SELECT * FROM _Sanctions_Screening_input WHERE screening_id <> '';

