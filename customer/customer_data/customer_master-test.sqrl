-- ## Customer Master Data - Test Data

IMPORT customer_master.*;

CREATE TABLE Customer (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_master-customer.jsonl',
    'source.monitor-interval' = '10 min',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_schema;

/** Customer address records supporting multiple address types per customer.
    Grain: one row per customer_id, address_type, effective_from combination. */
CREATE TABLE Customer_Address (
    /** Timestamp when record was ingested into the data platform */
    ingested_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_master-customer_address.jsonl',
    'source.monitor-interval' = '10 min',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Address_schema;

CREATE TABLE Customer_Contact (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_master-customer_contact.jsonl',
    'source.monitor-interval' = '10 min',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Contact_schema;

CREATE TABLE Customer_Employment (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_master-customer_employment.jsonl',
    'source.monitor-interval' = '10 min',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Employment_schema;

CREATE TABLE Customer_Relationship (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/customer_master-customer_relationship.jsonl',
    'source.monitor-interval' = '10 min',
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Customer_Relationship_schema;
