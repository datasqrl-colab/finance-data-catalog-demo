-- ## Customer Master Data
--
-- Core customer identity and demographic information representing the bank's
-- customer base. Contains foundational customer records, addresses, contact
-- information, employment details, and relationship linkages between customers.
-- This dataset serves as the authoritative source for customer identity across
-- all lines of business.
-- Data is a CDC stream from source system.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, FCRA

/** Primary customer record containing core identity and demographic attributes.
    Grain: one row per customer_id. */
CREATE TABLE Customer_schema (
  /** Unique identifier for the customer @pii */
  customer_id STRING NOT NULL,
  /** Legal first name @pii @encrypt */
  first_name STRING NOT NULL,
  /** Legal middle name @pii @encrypt */
  middle_name STRING,
  /** Legal last name @pii @encrypt */
  last_name STRING NOT NULL,
  /** Name suffix (Jr., Sr., III, etc.) */
  name_suffix STRING,
  /** Date of birth @spii @encrypt */
  date_of_birth DATE,
  /** Social Security Number @spii @tokenize @glba */
  ssn STRING,
  /** Tax Identification Number @spii @tokenize */
  tin STRING,
  /** Customer type: INDIVIDUAL, JOINT, TRUST, BUSINESS */
  customer_type STRING NOT NULL,
  /** Customer status: ACTIVE, INACTIVE, CLOSED, DECEASED */
  customer_status STRING NOT NULL,
  /** Date customer relationship was established */
  relationship_start_date DATE NOT NULL,
  /** Date customer relationship ended (if applicable) */
  relationship_end_date DATE,
  /** Primary citizenship country code (ISO 3166-1 alpha-2) */
  citizenship_country STRING,
  /** Residency country code (ISO 3166-1 alpha-2) */
  residency_country STRING,
  /** Preferred language code (ISO 639-1) */
  preferred_language STRING,
  /** Source system identifier */
  source_system STRING NOT NULL,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Customer address records supporting multiple address types per customer.
    Grain: one row per customer_id, address_type, effective_from combination. */
CREATE TABLE Customer_Address_schema (
  /** Reference to customer @pii */
  customer_id STRING NOT NULL,
  /** Address type: PRIMARY, MAILING, BILLING, WORK, SECONDARY */
  address_type STRING NOT NULL,
  /** Street address line 1 @pii @encrypt */
  address_line_1 STRING NOT NULL,
  /** Street address line 2 @pii @encrypt */
  address_line_2 STRING,
  /** City name @pii */
  city STRING NOT NULL,
  /** State or province code */
  state_province STRING,
  /** Postal or ZIP code @pii */
  postal_code STRING NOT NULL,
  /** Country code (ISO 3166-1 alpha-2) */
  country_code STRING NOT NULL,
  /** Date this address became effective */
  effective_from DATE NOT NULL,
  /** Date this address was superseded */
  effective_to DATE,
  /** Whether this is the current active address for this type */
  is_current BOOLEAN NOT NULL,
  /** Address verification status: VERIFIED, UNVERIFIED, INVALID */
  verification_status STRING NOT NULL,
  /** Date address was last verified */
  verified_at TIMESTAMP_LTZ(3),
  /** Source system identifier */
  source_system STRING NOT NULL,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Customer contact information including phone numbers and email addresses.
    Grain: one row per customer_id, contact_type, contact_value combination. */
CREATE TABLE Customer_Contact_schema (
  /** Reference to customer @pii */
  customer_id STRING NOT NULL,
  /** Contact type: MOBILE, HOME_PHONE, WORK_PHONE, EMAIL, FAX */
  contact_type STRING NOT NULL,
  /** Contact value (phone number or email address) @pii @encrypt */
  contact_value STRING NOT NULL,
  /** Whether this is the primary contact for this type */
  is_primary BOOLEAN NOT NULL,
  /** Contact verification status: VERIFIED, UNVERIFIED, INVALID */
  verification_status STRING NOT NULL,
  /** Date contact was last verified */
  verified_at TIMESTAMP_LTZ(3),
  /** Whether customer has opted in for marketing via this contact */
  marketing_opt_in BOOLEAN,
  /** Whether customer consents to transactional communications */
  transactional_opt_in BOOLEAN,
  /** Source system identifier */
  source_system STRING NOT NULL,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Customer employment and income information used for credit decisions.
    Grain: one row per customer_id, employer_name, employment_start_date combination. */
CREATE TABLE Customer_Employment_schema (
  /** Reference to customer @pii */
  customer_id STRING NOT NULL,
  /** Name of employer @pii */
  employer_name STRING NOT NULL,
  /** Job title or position @pii */
  job_title STRING,
  /** Employment type: FULL_TIME, PART_TIME, SELF_EMPLOYED, RETIRED, UNEMPLOYED */
  employment_type STRING NOT NULL,
  /** Employment status: CURRENT, FORMER */
  employment_status STRING NOT NULL,
  /** Date employment began */
  employment_start_date DATE NOT NULL,
  /** Date employment ended (if applicable) */
  employment_end_date DATE,
  /** Annual income in cents @npi @confidential */
  annual_income_cents BIGINT,
  /** Currency code for income (ISO 4217) */
  income_currency STRING,
  /** Income verification status: VERIFIED, STATED, UNVERIFIED */
  income_verification_status STRING,
  /** Date income was last verified */
  income_verified_at TIMESTAMP_LTZ(3),
  /** Source system identifier */
  source_system STRING NOT NULL,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Relationships between customers (household members, authorized users, etc.).
    Grain: one row per primary_customer_id, related_customer_id, relationship_type combination. */
CREATE TABLE Customer_Relationship_schema (
  /** Primary customer in the relationship @pii */
  primary_customer_id STRING NOT NULL,
  /** Related customer @pii */
  related_customer_id STRING NOT NULL,
  /** Relationship type: SPOUSE, DEPENDENT, AUTHORIZED_USER, POWER_OF_ATTORNEY, BENEFICIARY, JOINT_OWNER */
  relationship_type STRING NOT NULL,
  /** Date relationship was established */
  relationship_start_date DATE NOT NULL,
  /** Date relationship ended (if applicable) */
  relationship_end_date DATE,
  /** Whether this relationship is currently active */
  is_active BOOLEAN NOT NULL,
  /** Source system identifier */
  source_system STRING NOT NULL,
  /** Timestamp when record was last updated in source system */
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);
