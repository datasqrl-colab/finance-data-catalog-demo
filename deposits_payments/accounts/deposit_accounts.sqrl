-- ## Deposit Accounts
--
-- Core deposit account information including checking, savings, money market,
-- and certificate of deposit accounts. Contains account ownership, status history,
-- and product configuration data that forms the foundation of the bank's deposit
-- product portfolio.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, Regulation E, Regulation DD

/** Primary deposit account record containing account attributes and status.
    Grain: one row per account_id.

    # Columns:
    * account_id: Unique identifier for the account @npi
    * account_number: Account number displayed to customer @npi @mask
    * account_type: Account type: CHECKING, SAVINGS, MONEY_MARKET, CD, IRA
    * product_code: Product code reference
    * account_title: Account title or name @pii
    * account_status: Account status: OPEN, CLOSED, DORMANT, FROZEN, ESCHEAT
    * opened_date: Date account was opened
    * closed_date: Date account was closed (if applicable)
    * closure_reason: Reason for account closure
    * opening_branch_id: Branch ID where account was opened
    * servicing_branch_id: Branch ID for account servicing
    * currency_code: Account currency code (ISO 4217)
    * interest_rate: Current interest rate (annual percentage)
    * compounding_frequency: Interest compounding frequency: DAILY, MONTHLY, QUARTERLY, ANNUALLY
    * interest_payment_frequency: Interest payment frequency: MONTHLY, QUARTERLY, ANNUALLY, AT_MATURITY
    * maturity_date: Maturity date for CDs
    * original_term_months: Original term in months for CDs
    * overdraft_protection_enabled: Whether overdraft protection is enabled
    * overdraft_linked_account_id: Linked account for overdraft protection @npi
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Account_schema (
  account_id STRING NOT NULL,
  account_number STRING NOT NULL,
  account_type STRING NOT NULL,
  product_code STRING NOT NULL,
  account_title STRING NOT NULL,
  account_status STRING NOT NULL,
  opened_date DATE NOT NULL,
  closed_date DATE,
  closure_reason STRING,
  opening_branch_id STRING,
  servicing_branch_id STRING,
  currency_code STRING NOT NULL,
  interest_rate DECIMAL(10, 6),
  compounding_frequency STRING,
  interest_payment_frequency STRING,
  maturity_date DATE,
  original_term_months INT,
  overdraft_protection_enabled BOOLEAN NOT NULL,
  overdraft_linked_account_id STRING,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Account ownership and holder information linking customers to accounts.
    Grain: one row per account_id, customer_id combination.

    # Columns:
    * account_id: Reference to account @npi
    * customer_id: Reference to customer @pii
    * holder_type: Holder type: PRIMARY, JOINT, BENEFICIARY, CUSTODIAN, TRUSTEE, POA
    * ownership_percentage: Ownership percentage (for joint accounts)
    * has_signing_authority: Whether holder has signing authority
    * added_date: Date holder was added to account
    * removed_date: Date holder was removed from account
    * is_active: Whether this holder is currently active on the account
    * tax_reporting_percentage: Tax reporting responsibility percentage
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Account_Holder_schema (
  account_id STRING NOT NULL,
  customer_id STRING NOT NULL,
  holder_type STRING NOT NULL,
  ownership_percentage DECIMAL(5, 2),
  has_signing_authority BOOLEAN NOT NULL,
  added_date DATE NOT NULL,
  removed_date DATE,
  is_active BOOLEAN NOT NULL,
  tax_reporting_percentage DECIMAL(5, 2),
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Account status change history for audit and compliance tracking.
    Grain: one row per account_id, status_changed_at combination.

    # Columns:
    * account_id: Reference to account @npi
    * previous_status: Previous account status
    * new_status: New account status
    * change_reason: Reason for status change
    * status_changed_at: Date and time status was changed
    * changed_by: Employee or system that initiated the change
    * change_channel: Channel through which change was made: BRANCH, ONLINE, PHONE, SYSTEM
    * notes: Additional notes about the status change @confidential
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Account_Status_History_schema (
  account_id STRING NOT NULL,
  previous_status STRING NOT NULL,
  new_status STRING NOT NULL,
  change_reason STRING,
  status_changed_at TIMESTAMP_LTZ(3) NOT NULL,
  changed_by STRING NOT NULL,
  change_channel STRING NOT NULL,
  notes STRING,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Deposit product configuration and terms reference data.
    Grain: one row per product_code, effective_from combination.

    # Columns:
    * product_code: Unique product code
    * product_name: Product name
    * product_category: Product category: CHECKING, SAVINGS, MONEY_MARKET, CD, IRA
    * is_active: Whether product is currently available for new accounts
    * minimum_opening_deposit_cents: Minimum opening deposit in cents
    * minimum_balance_cents: Minimum balance to avoid fees in cents
    * monthly_fee_cents: Monthly maintenance fee in cents
    * fee_waiver_eligible: Whether fee can be waived
    * fee_waiver_conditions: Conditions for fee waiver
    * base_interest_rate: Base interest rate (APY)
    * rate_tiers: Interest rate tier structure (JSON) @confidential
    * max_monthly_transactions: Maximum transactions per month (Reg D for savings)
    * interest_bearing: Whether account earns interest
    * fdic_insured: FDIC insurance eligible
    * effective_from: Date product became effective
    * effective_to: Date product was discontinued
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Account_Product_schema (
  product_code STRING NOT NULL,
  product_name STRING NOT NULL,
  product_category STRING NOT NULL,
  is_active BOOLEAN NOT NULL,
  minimum_opening_deposit_cents BIGINT,
  minimum_balance_cents BIGINT,
  monthly_fee_cents BIGINT,
  fee_waiver_eligible BOOLEAN NOT NULL,
  fee_waiver_conditions STRING,
  base_interest_rate DECIMAL(10, 6),
  rate_tiers STRING,
  max_monthly_transactions INT,
  interest_bearing BOOLEAN NOT NULL,
  fdic_insured BOOLEAN NOT NULL,
  effective_from DATE NOT NULL,
  effective_to DATE,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);
