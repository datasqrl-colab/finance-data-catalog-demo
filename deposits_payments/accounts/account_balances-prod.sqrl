-- ## Account Balances - Production
--
-- Ingests source data from Kafka

IMPORT account_balances.*;

CREATE TABLE Account_Balance_Daily (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT_BALANCE_DAILY}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_Balance_Daily_schema;

CREATE TABLE Interest_Accrual (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_INTEREST_ACCRUAL}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Interest_Accrual_schema;

CREATE TABLE Account_Hold (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT_HOLD}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_Hold_schema;
