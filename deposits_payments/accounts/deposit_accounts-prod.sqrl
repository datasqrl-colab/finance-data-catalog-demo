-- ## Deposit Accounts - Production
--
-- Ingests source data from Kafka

IMPORT deposit_accounts.*;

CREATE TABLE Account (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_schema;

CREATE TABLE Account_Holder (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT_HOLDER}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_Holder_schema;

CREATE TABLE Account_Status_History (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT_STATUS_HISTORY}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_Status_History_schema;

CREATE TABLE Account_Product (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_ACCOUNT_PRODUCT}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Account_Product_schema;
