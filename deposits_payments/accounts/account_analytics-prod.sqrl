-- ## Account Analytics - Production
--
-- Writes analytics data to Apache Iceberg tables

IMPORT account_analytics.*;

CREATE TABLE Account_Activity_Summary (
  /** Timestamp when summary was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (account_id, summary_month) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'deposits_payments',
    'catalog-database' = 'accounts',
    'catalog-table' = 'account_activity_summary',
    'warehouse' = '${DEPOSITS_PAYMENTS_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Account_Activity_Summary_schema;

CREATE TABLE Account_Balance_Trend (
  /** Timestamp when trend was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (account_id, trend_date) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'deposits_payments',
    'catalog-database' = 'accounts',
    'catalog-table' = 'account_balance_trend',
    'warehouse' = '${DEPOSITS_PAYMENTS_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Account_Balance_Trend_schema;

CREATE TABLE Dormancy_Signal (
  /** Timestamp when signal was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL,
  PRIMARY KEY (account_id, assessment_date) NOT ENFORCED
) WITH (
    'connector' = 'iceberg',
    'catalog-type' = 'hadoop',
    'catalog-name' = 'deposits_payments',
    'catalog-database' = 'accounts',
    'catalog-table' = 'dormancy_signal',
    'warehouse' = '${DEPOSITS_PAYMENTS_ICEBERG_WAREHOUSE}',
    'format-version' = '2',
    'write.upsert.enabled' = 'true'
) LIKE Dormancy_Signal_schema;
