-- ## Wire and ACH Transactions
--
-- Electronic funds transfer data including ACH transactions, domestic and
-- international wire transfers, and payment returns. Supports regulatory
-- reporting requirements and fraud monitoring for high-value transfers.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, BSA, OFAC, Regulation E

/** ACH transaction records for direct deposits, bill payments, and transfers.
    Grain: one row per ach_transaction_id.

    # Columns:
    * ach_transaction_id: Unique identifier for the ACH transaction
    * transaction_id: Reference to posted transaction
    * account_id: Reference to account @npi
    * direction: Direction: INBOUND, OUTBOUND
    * ach_type: ACH transaction type: CREDIT, DEBIT
    * sec_code: SEC code: PPD, CCD, WEB, TEL, etc.
    * amount_cents: Transaction amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * transaction_status: Transaction status: ORIGINATED, PENDING, POSTED, RETURNED, REJECTED
    * odfi_routing_number: Originating DFI routing number
    * odfi_name: Originating DFI name
    * rdfi_routing_number: Receiving DFI routing number
    * rdfi_name: Receiving DFI name
    * company_id: Company/batch ID
    * company_name: Company name @pii
    * entry_description: Company entry description
    * individual_name: Individual/account name @pii @encrypt
    * individual_id: Individual identification number @pii @tokenize
    * trace_number: Trace number
    * addenda: Addenda records (JSON) @pii
    * effective_date: Effective entry date
    * settlement_date: Settlement date
    * processed_at: Date and time transaction was processed
    * is_same_day: Whether transaction is same-day ACH
    * batch_number: Batch reference number
    * file_id: File ID from ACH file
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Ach_Transaction_schema (
  ach_transaction_id STRING NOT NULL,
  transaction_id STRING,
  account_id STRING NOT NULL,
  direction STRING NOT NULL,
  ach_type STRING NOT NULL,
  sec_code STRING NOT NULL,
  amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  transaction_status STRING NOT NULL,
  odfi_routing_number STRING,
  odfi_name STRING,
  rdfi_routing_number STRING,
  rdfi_name STRING,
  company_id STRING,
  company_name STRING,
  entry_description STRING,
  individual_name STRING,
  individual_id STRING,
  trace_number STRING,
  addenda STRING,
  effective_date DATE,
  settlement_date DATE,
  processed_at TIMESTAMP_LTZ(3) NOT NULL,
  is_same_day BOOLEAN NOT NULL,
  batch_number STRING,
  file_id STRING,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Wire transfer records for domestic and international transfers.
    Grain: one row per wire_transfer_id.

    # Columns:
    * wire_transfer_id: Unique identifier for the wire transfer
    * transaction_id: Reference to posted transaction
    * account_id: Reference to account @npi
    * customer_id: Reference to customer @pii
    * direction: Direction: INBOUND, OUTBOUND
    * wire_type: Wire type: DOMESTIC, INTERNATIONAL
    * amount_cents: Transfer amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * fee_cents: Fee amount in cents
    * total_amount_cents: Total amount debited/credited in cents @npi @confidential
    * wire_status: Wire status: INITIATED, PENDING, SENT, RECEIVED, COMPLETED, RETURNED, CANCELLED
    * originator_name: Originator name @pii @encrypt
    * originator_address: Originator address @pii @encrypt
    * originator_account: Originator account number @npi @mask
    * originator_bank_name: Originator bank name
    * originator_bank_id: Originator bank routing/SWIFT @bsa
    * beneficiary_name: Beneficiary name @pii @encrypt
    * beneficiary_address: Beneficiary address @pii @encrypt
    * beneficiary_account: Beneficiary account number @npi @mask
    * beneficiary_bank_name: Beneficiary bank name
    * beneficiary_bank_id: Beneficiary bank routing/SWIFT @bsa
    * beneficiary_country: Beneficiary bank country
    * intermediary_bank_name: Intermediary bank name (for international)
    * intermediary_bank_id: Intermediary bank SWIFT
    * purpose: Purpose of wire transfer @confidential
    * reference_for_beneficiary: Reference for beneficiary
    * fed_reference: OMAD/IMAD reference number
    * swift_reference: SWIFT reference (for international)
    * ofac_status: OFAC screening result: CLEAR, HOLD, BLOCKED
    * initiated_at: Date and time wire was initiated
    * sent_at: Date and time wire was sent
    * completed_at: Date and time wire was completed
    * initiated_by: Employee or system initiating wire @pii
    * approval_status: Approval status: PENDING, APPROVED, REJECTED
    * approved_by: Employee approving wire @pii
    * approved_at: Date and time of approval
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Wire_Transfer_schema (
  wire_transfer_id STRING NOT NULL,
  transaction_id STRING,
  account_id STRING NOT NULL,
  customer_id STRING,
  direction STRING NOT NULL,
  wire_type STRING NOT NULL,
  amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  fee_cents BIGINT,
  total_amount_cents BIGINT,
  wire_status STRING NOT NULL,
  originator_name STRING,
  originator_address STRING,
  originator_account STRING,
  originator_bank_name STRING,
  originator_bank_id STRING,
  beneficiary_name STRING NOT NULL,
  beneficiary_address STRING,
  beneficiary_account STRING NOT NULL,
  beneficiary_bank_name STRING,
  beneficiary_bank_id STRING,
  beneficiary_country STRING,
  intermediary_bank_name STRING,
  intermediary_bank_id STRING,
  purpose STRING,
  reference_for_beneficiary STRING,
  fed_reference STRING,
  swift_reference STRING,
  ofac_status STRING,
  initiated_at TIMESTAMP_LTZ(3) NOT NULL,
  sent_at TIMESTAMP_LTZ(3),
  completed_at TIMESTAMP_LTZ(3),
  initiated_by STRING,
  approval_status STRING NOT NULL,
  approved_by STRING,
  approved_at TIMESTAMP_LTZ(3),
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Payment return records for ACH returns and wire rejects.
    Grain: one row per return_id.

    # Columns:
    * return_id: Unique identifier for the return
    * ach_transaction_id: Reference to original ACH transaction
    * wire_transfer_id: Reference to original wire transfer
    * original_transaction_id: Reference to original transaction
    * return_transaction_id: Reference to return transaction
    * account_id: Reference to account @npi
    * return_type: Return type: ACH_RETURN, ACH_NOC, WIRE_RETURN, WIRE_REJECT
    * return_amount_cents: Return amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * return_status: Return status: PENDING, PROCESSED, DISPUTED
    * return_reason_code: Return reason code (R01-R85 for ACH)
    * return_reason_description: Return reason description @confidential
    * original_effective_date: Original effective date
    * return_effective_date: Return effective date
    * processed_at: Date and time return was processed
    * original_trace_number: Trace number of original transaction
    * return_trace_number: Trace number of return
    * addenda: Addenda information (JSON) @pii
    * is_dishonored: Whether return was dishonored
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Payment_Return_schema (
  return_id STRING NOT NULL,
  ach_transaction_id STRING,
  wire_transfer_id STRING,
  original_transaction_id STRING NOT NULL,
  return_transaction_id STRING,
  account_id STRING NOT NULL,
  return_type STRING NOT NULL,
  return_amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  return_status STRING NOT NULL,
  return_reason_code STRING NOT NULL,
  return_reason_description STRING,
  original_effective_date DATE,
  return_effective_date DATE,
  processed_at TIMESTAMP_LTZ(3) NOT NULL,
  original_trace_number STRING,
  return_trace_number STRING,
  addenda STRING,
  is_dishonored BOOLEAN NOT NULL,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);
