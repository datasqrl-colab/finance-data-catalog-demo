-- ## Core Transactions - Production
--
-- Ingests source data from Kafka

IMPORT core_transactions.*;

CREATE TABLE AccountTransaction (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_PREFIX}.transaction',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE AccountTransaction_schema;

CREATE TABLE Transaction_Type (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_PREFIX}.transaction_type',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Transaction_Type_schema;

CREATE TABLE Transaction_Reversal (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${DEPOSITS_PAYMENTS_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_PREFIX}.transaction_reversal',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Transaction_Reversal_schema;
