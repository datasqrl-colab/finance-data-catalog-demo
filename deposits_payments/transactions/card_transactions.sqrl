-- ## Card Transactions
--
-- Debit and prepaid card transaction data including real-time authorizations,
-- settlements, and chargeback processing. Captures the full lifecycle of
-- card-based payments from authorization through final settlement and any
-- disputes that may arise.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, Regulation E, PCI-DSS

/** Real-time card authorization requests and responses.
    Grain: one row per authorization_id.

    # Columns:
    * authorization_id: Unique identifier for the authorization
    * card_id: Reference to card used @pci @tokenize
    * account_id: Reference to account @npi
    * authorization_amount_cents: Authorization amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * merchant_amount_cents: Merchant amount if different currency in cents
    * merchant_currency_code: Merchant currency code
    * exchange_rate: Exchange rate applied
    * authorization_status: Authorization status: APPROVED, DECLINED, PENDING, EXPIRED, REVERSED
    * decline_reason_code: Decline reason code if declined
    * authorized_at: Date and time of authorization
    * expires_at: Authorization expiration timestamp
    * merchant_name: Merchant name @pii
    * merchant_id: Merchant ID
    * mcc_code: Merchant Category Code
    * merchant_city: Merchant city @pii
    * merchant_state: Merchant state or province
    * merchant_country: Merchant country code
    * transaction_type: Transaction type: PURCHASE, CASH_ADVANCE, REFUND, BALANCE_INQUIRY
    * entry_mode: Entry mode: CHIP, SWIPE, CONTACTLESS, MANUAL, ECOMMERCE, RECURRING
    * pin_used: Whether PIN was used
    * card_present: Whether card was present
    * network: Network: VISA, MASTERCARD, DISCOVER, AMEX
    * network_reference_id: Network reference ID
    * rrn: Retrieval reference number
    * authorization_code: Authorization code from network
    * cvv_result: CVV verification result
    * avs_result: AVS verification result
    * three_ds_result: 3D Secure result if applicable
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Card_Authorization_schema (
  authorization_id STRING NOT NULL,
  card_id STRING NOT NULL,
  account_id STRING NOT NULL,
  authorization_amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  merchant_amount_cents BIGINT,
  merchant_currency_code STRING,
  exchange_rate DECIMAL(12, 6),
  authorization_status STRING NOT NULL,
  decline_reason_code STRING,
  authorized_at TIMESTAMP_LTZ(3) NOT NULL,
  expires_at TIMESTAMP_LTZ(3) NOT NULL,
  merchant_name STRING NOT NULL,
  merchant_id STRING,
  mcc_code STRING,
  merchant_city STRING,
  merchant_state STRING,
  merchant_country STRING,
  transaction_type STRING NOT NULL,
  entry_mode STRING NOT NULL,
  pin_used BOOLEAN,
  card_present BOOLEAN,
  network STRING NOT NULL,
  network_reference_id STRING,
  rrn STRING,
  authorization_code STRING,
  cvv_result STRING,
  avs_result STRING,
  three_ds_result STRING,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Card transaction settlements from payment networks.
    Grain: one row per settlement_id.

    # Columns:
    * settlement_id: Unique identifier for the settlement
    * authorization_id: Reference to original authorization
    * transaction_id: Reference to posted transaction
    * card_id: Reference to card @pci @tokenize
    * account_id: Reference to account @npi
    * settlement_amount_cents: Settlement amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * authorization_amount_cents: Original authorization amount in cents
    * variance_cents: Difference between settlement and authorization in cents
    * settlement_status: Settlement status: SETTLED, PENDING, REJECTED
    * settled_at: Date and time of settlement
    * network_settlement_date: Settlement date from network
    * merchant_name: Merchant name @pii
    * merchant_id: Merchant ID
    * mcc_code: Merchant Category Code
    * network: Network: VISA, MASTERCARD, DISCOVER, AMEX
    * network_reference_id: Network reference ID
    * interchange_fee_cents: Interchange fee in cents @confidential
    * assessment_fee_cents: Network assessment fee in cents @confidential
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Card_Settlement_schema (
  settlement_id STRING NOT NULL,
  authorization_id STRING NOT NULL,
  transaction_id STRING,
  card_id STRING NOT NULL,
  account_id STRING NOT NULL,
  settlement_amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  authorization_amount_cents BIGINT,
  variance_cents BIGINT,
  settlement_status STRING NOT NULL,
  settled_at TIMESTAMP_LTZ(3),
  network_settlement_date DATE,
  merchant_name STRING NOT NULL,
  merchant_id STRING,
  mcc_code STRING,
  network STRING NOT NULL,
  network_reference_id STRING,
  interchange_fee_cents BIGINT,
  assessment_fee_cents BIGINT,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Card dispute and chargeback records.
    Grain: one row per chargeback_id.

    # Columns:
    * chargeback_id: Unique identifier for the chargeback
    * transaction_id: Reference to original transaction
    * settlement_id: Reference to settlement
    * card_id: Reference to card @pci @tokenize
    * account_id: Reference to account @npi
    * customer_id: Reference to customer @pii
    * chargeback_amount_cents: Chargeback amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * chargeback_status: Chargeback status: INITIATED, PENDING, WON, LOST, EXPIRED
    * reason_code: Reason code per network rules
    * reason_description: Reason description @confidential
    * chargeback_category: Category: FRAUD, CONSUMER_DISPUTE, PROCESSING_ERROR, AUTHORIZATION
    * initiated_at: Date chargeback was initiated
    * response_due_date: Response deadline
    * resolved_at: Date chargeback was resolved
    * resolution_outcome: Resolution outcome: MERCHANT_WIN, CUSTOMER_WIN, SPLIT
    * recovery_amount_cents: Amount recovered from merchant in cents
    * merchant_name: Merchant name @pii
    * merchant_id: Merchant ID
    * network: Network handling the dispute
    * network_case_number: Network case number
    * provisional_credit_issued: Whether provisional credit was issued
    * provisional_credit_date: Date provisional credit was issued
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Card_Chargeback_schema (
  chargeback_id STRING NOT NULL,
  transaction_id STRING NOT NULL,
  settlement_id STRING,
  card_id STRING NOT NULL,
  account_id STRING NOT NULL,
  customer_id STRING,
  chargeback_amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  chargeback_status STRING NOT NULL,
  reason_code STRING NOT NULL,
  reason_description STRING,
  chargeback_category STRING NOT NULL,
  initiated_at TIMESTAMP_LTZ(3) NOT NULL,
  response_due_date DATE,
  resolved_at TIMESTAMP_LTZ(3),
  resolution_outcome STRING,
  recovery_amount_cents BIGINT,
  merchant_name STRING,
  merchant_id STRING,
  network STRING NOT NULL,
  network_case_number STRING,
  provisional_credit_issued BOOLEAN NOT NULL,
  provisional_credit_date DATE,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);

/** Merchant Category Code reference data for transaction classification.
    Grain: one row per mcc_code.

    # Columns:
    * mcc_code: Merchant Category Code
    * mcc_description: MCC description
    * category: Category grouping
    * subcategory: Subcategory
    * is_high_risk: Whether MCC is considered high-risk
    * is_cash_equivalent: Whether MCC may indicate cash-like transaction
    * is_restricted: Whether MCC is restricted for certain card programs
    * tax_category: Default tax category
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Mcc_Reference_schema (
  mcc_code STRING NOT NULL,
  mcc_description STRING NOT NULL,
  category STRING,
  subcategory STRING,
  is_high_risk BOOLEAN NOT NULL,
  is_cash_equivalent BOOLEAN NOT NULL,
  is_restricted BOOLEAN NOT NULL,
  tax_category STRING,
  source_system STRING NOT NULL,
  source_updated_at TIMESTAMP_LTZ(3) NOT NULL
);
