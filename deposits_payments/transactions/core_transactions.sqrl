-- ## Core Transactions
--
-- Foundation transaction data capturing all monetary movements across accounts.
-- Includes the primary transaction ledger, transaction type reference data,
-- and reversal/correction records. This dataset serves as the authoritative
-- source for all account-level transaction activity.
--
-- Layer:            bronze
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA, Regulation E, BSA
-- Note: The ledger table is named Account_Transaction rather than Transaction
--       because `Transaction` is a reserved Flink SQL keyword and fails to
--       parse as a standalone table name.

/** Primary transaction ledger recording all account monetary movements.
    Grain: one row per transaction_id.

    # Columns:
    * transaction_id: Unique identifier for the transaction
    * account_id: Reference to account @npi
    * transaction_type_code: Transaction type code reference
    * transaction_category: Transaction category: DEBIT, CREDIT
    * amount_cents: Transaction amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * transaction_status: Transaction status: PENDING, POSTED, REVERSED, RETURNED
    * posted_date: Date transaction was posted to account
    * transaction_at: Date and time transaction occurred
    * effective_date: Effective date for interest calculation
    * description: Transaction description @pii
    * memo: Memo or reference text @pii
    * running_balance_cents: Running balance after transaction in cents @npi @confidential
    * channel: Channel: BRANCH, ATM, ONLINE, MOBILE, ACH, WIRE, INSTANT, CHECK, POS, INTERNAL
    * external_reference: Reference number for external transactions
    * trace_number: Trace number for ACH transactions
    * check_number: Check number if applicable
    * branch_id: Branch ID where transaction occurred
    * terminal_id: Terminal or device ID
    * teller_id: Employee ID if branch transaction @pii
    * counterparty_account_id: Counterparty account reference @npi
    * counterparty_name: Counterparty name @pii
    * is_reconciled: Whether transaction has been reconciled
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Account_Transaction_schema (
  transaction_id STRING NOT NULL,
  account_id STRING NOT NULL,
  transaction_type_code STRING,
  transaction_category STRING,
  amount_cents BIGINT,
  currency_code STRING,
  transaction_status STRING,
  posted_date DATE,
  transaction_at TIMESTAMP_LTZ(3),
  effective_date DATE,
  description STRING,
  memo STRING,
  running_balance_cents BIGINT,
  channel STRING,
  external_reference STRING,
  trace_number STRING,
  check_number STRING,
  branch_id STRING,
  terminal_id STRING,
  teller_id STRING,
  counterparty_account_id STRING,
  counterparty_name STRING,
  is_reconciled BOOLEAN,
  source_system STRING,
  source_updated_at TIMESTAMP_LTZ(3)
);

/** Transaction type reference data defining transaction classifications.
    Grain: one row per transaction_type_code.

    # Columns:
    * transaction_type_code: Unique transaction type code
    * transaction_type_name: Transaction type name
    * description: Transaction type description
    * category: Category: DEBIT, CREDIT
    * subcategory: Subcategory for reporting
    * is_customer_initiated: Whether this type is customer-initiated
    * affects_available_balance: Whether this type affects available balance
    * is_fee: Whether this type is fee-related
    * is_interest: Whether this type is interest-related
    * gl_account_code: GL account code for posting
    * is_active: Whether type is currently active
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Transaction_Type_schema (
  transaction_type_code STRING NOT NULL,
  transaction_type_name STRING,
  description STRING,
  category STRING,
  subcategory STRING,
  is_customer_initiated BOOLEAN,
  affects_available_balance BOOLEAN,
  is_fee BOOLEAN,
  is_interest BOOLEAN,
  gl_account_code STRING,
  is_active BOOLEAN,
  source_system STRING,
  source_updated_at TIMESTAMP_LTZ(3)
);

/** Transaction reversals and corrections linking to original transactions.
    Grain: one row per reversal_id.

    # Columns:
    * reversal_id: Unique identifier for the reversal
    * original_transaction_id: Reference to original transaction being reversed
    * reversing_transaction_id: Reference to the reversing transaction
    * reversal_type: Reversal type: FULL, PARTIAL, CORRECTION
    * reversal_amount_cents: Amount reversed in cents @npi @confidential
    * reason_code: Reason code for reversal
    * reason_description: Reason description @confidential
    * reversed_at: Date and time reversal was initiated
    * posted_date: Date reversal was posted
    * reversed_by: Employee or system initiating reversal
    * approved_by: Supervisor approval if required @pii
    * channel: Channel through which reversal was made
    * source_system: Source system identifier
    * source_updated_at: Timestamp when record was last updated in source system */
CREATE TABLE Transaction_Reversal_schema (
  reversal_id STRING NOT NULL,
  original_transaction_id STRING NOT NULL,
  reversing_transaction_id STRING NOT NULL,
  reversal_type STRING,
  reversal_amount_cents BIGINT,
  reason_code STRING,
  reason_description STRING,
  reversed_at TIMESTAMP_LTZ(3),
  posted_date DATE,
  reversed_by STRING,
  approved_by STRING,
  channel STRING,
  source_system STRING,
  source_updated_at TIMESTAMP_LTZ(3)
);
