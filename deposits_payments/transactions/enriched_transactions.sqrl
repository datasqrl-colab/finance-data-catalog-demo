-- ## Enriched Transactions
--
-- Silver-layer transaction data combining and enriching information from
-- multiple bronze sources to create unified transaction views with merchant
-- enrichment, categorization, and recurring payment detection.
--
-- Layer:            silver
-- Classification:   Restricted
-- Regulatory scope: GLBA, GDPR, CCPA
-- Upstream:         core_transactions.sqrl, card_transactions.sqrl, wire_ach_transactions.sqrl

/** Unified transaction view combining all transaction types with standardized attributes.
    Grain: one row per transaction_id.

    # Columns:
    * transaction_id: Unique identifier for the transaction
    * account_id: Reference to account @npi
    * customer_id: Reference to customer @pii
    * transaction_source: Transaction source: CORE, CARD, ACH, WIRE
    * source_transaction_id: Original source system transaction ID
    * transaction_type: Standardized transaction type
    * debit_credit: Transaction category: DEBIT, CREDIT
    * amount_cents: Transaction amount in cents @npi @confidential
    * currency_code: Currency code (ISO 4217)
    * transaction_status: Transaction status: PENDING, POSTED, REVERSED, RETURNED
    * transaction_at: Date and time transaction occurred
    * posted_date: Date transaction was posted
    * original_description: Original description @pii
    * clean_description: Cleaned/standardized description @pii
    * channel: Transaction channel: BRANCH, ATM, ONLINE, MOBILE, ACH, WIRE, POS, CHECK
    * merchant_id: Merchant or counterparty ID (enriched)
    * merchant_name: Merchant or counterparty name (enriched) @pii
    * mcc_code: Merchant category code
    * category_id: Transaction category ID
    * category_name: Transaction category name
    * subcategory_name: Transaction subcategory name
    * is_recurring: Whether transaction is identified as recurring
    * recurring_payment_id: Recurring payment ID if applicable
    * location: Geographic location of transaction @pii
    * city: City of transaction @pii
    * state: State/province of transaction
    * country: Country of transaction
    * running_balance_cents: Running balance after transaction in cents @npi @confidential
    * is_disputed: Whether transaction has been disputed
    * is_suspicious: Whether transaction is potentially fraudulent
    * fraud_score: Fraud score (0-100) */
CREATE TABLE Unified_Transaction_schema (
  transaction_id STRING NOT NULL,
  account_id STRING NOT NULL,
  customer_id STRING,
  transaction_source STRING NOT NULL,
  source_transaction_id STRING,
  transaction_type STRING NOT NULL,
  debit_credit STRING NOT NULL,
  amount_cents BIGINT NOT NULL,
  currency_code STRING NOT NULL,
  transaction_status STRING NOT NULL,
  transaction_at TIMESTAMP_LTZ(3) NOT NULL,
  posted_date DATE,
  original_description STRING,
  clean_description STRING,
  channel STRING NOT NULL,
  merchant_id STRING,
  merchant_name STRING,
  mcc_code STRING,
  category_id STRING,
  category_name STRING,
  subcategory_name STRING,
  is_recurring BOOLEAN NOT NULL,
  recurring_payment_id STRING,
  location STRING,
  city STRING,
  state STRING,
  country STRING,
  running_balance_cents BIGINT,
  is_disputed BOOLEAN NOT NULL,
  is_suspicious BOOLEAN NOT NULL,
  fraud_score INT
);

/** Merchant enrichment data providing standardized merchant information.
    Grain: one row per merchant_id.

    # Columns:
    * merchant_id: Unique identifier for the merchant
    * raw_merchant_name: Raw merchant name as received
    * clean_merchant_name: Cleaned/standardized merchant name
    * parent_company: Parent company name
    * logo_url: Merchant logo URL
    * website: Merchant website
    * primary_mcc: Primary MCC code
    * primary_category: Primary category
    * primary_subcategory: Primary subcategory
    * merchant_type: Merchant type: RETAIL, RESTAURANT, SERVICE, UTILITY, SUBSCRIPTION, GOVERNMENT
    * is_subscription: Whether merchant is a subscription service
    * is_utility: Whether merchant is a utility provider
    * is_financial_institution: Whether merchant is a financial institution
    * enrichment_source: Enrichment provider: PLAID, YODLEE, MX, INTERNAL
    * confidence_score: Confidence score for enrichment (0-100)
    * last_updated_at: Date enrichment was last updated */
CREATE TABLE Merchant_Enrichment_schema (
  merchant_id STRING NOT NULL,
  raw_merchant_name STRING NOT NULL,
  clean_merchant_name STRING,
  parent_company STRING,
  logo_url STRING,
  website STRING,
  primary_mcc STRING,
  primary_category STRING,
  primary_subcategory STRING,
  merchant_type STRING,
  is_subscription BOOLEAN NOT NULL,
  is_utility BOOLEAN NOT NULL,
  is_financial_institution BOOLEAN NOT NULL,
  enrichment_source STRING NOT NULL,
  confidence_score INT,
  last_updated_at TIMESTAMP_LTZ(3)
);

/** Transaction category reference for spending classification.
    Grain: one row per category_id.

    # Columns:
    * category_id: Unique identifier for the category
    * category_name: Category name
    * parent_category_id: Parent category ID for hierarchy
    * category_level: Category level in hierarchy (1=top level)
    * category_path: Full category path
    * description: Category description
    * icon: Category icon
    * color: Display color
    * is_system: Whether this is a system-defined category
    * is_active: Whether category is currently active
    * sort_order: Sort order for display
    * created_at: Timestamp when category was created
    * updated_at: Timestamp when category was last updated */
CREATE TABLE Transaction_Category_schema (
  category_id STRING NOT NULL,
  category_name STRING NOT NULL,
  parent_category_id STRING,
  category_level INT NOT NULL,
  category_path STRING,
  description STRING,
  icon STRING,
  color STRING,
  is_system BOOLEAN NOT NULL,
  is_active BOOLEAN NOT NULL,
  sort_order INT,
  created_at TIMESTAMP_LTZ(3) NOT NULL,
  updated_at TIMESTAMP_LTZ(3)
);

/** Recurring payment detection and tracking.
    Grain: one row per recurring_payment_id.

    # Columns:
    * recurring_payment_id: Unique identifier for the recurring payment series
    * account_id: Reference to account @npi
    * customer_id: Reference to customer @pii
    * merchant_id: Merchant ID for this recurring payment
    * merchant_name: Merchant name @pii
    * payment_type: Recurring payment type: SUBSCRIPTION, BILL, LOAN_PAYMENT, MEMBERSHIP, INSURANCE
    * typical_amount_cents: Typical amount in cents @npi @confidential
    * amount_variance_cents: Amount variance tolerance in cents
    * frequency: Payment frequency: WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, ANNUAL
    * typical_day: Typical day of month or week for payment
    * day_variance: Day variance tolerance
    * first_occurrence_date: Date of first detected occurrence
    * last_occurrence_date: Date of most recent occurrence
    * next_expected_date: Date of next expected occurrence
    * occurrence_count: Number of occurrences detected
    * missed_count: Number of missed/late occurrences
    * status: Recurring payment status: ACTIVE, PAUSED, ENDED, UNCERTAIN
    * confidence_score: Confidence score for detection (0-100)
    * category_name: Category of recurring payment
    * is_essential: Whether payment is essential (utility, insurance, etc.)
    * annual_cost_cents: Annual cost in cents @npi @confidential
    * detection_method: Detection method: AMOUNT_FREQUENCY, MERCHANT_MATCH, DESCRIPTION_MATCH */
CREATE TABLE Recurring_Payment_schema (
  recurring_payment_id STRING NOT NULL,
  account_id STRING NOT NULL,
  customer_id STRING,
  merchant_id STRING,
  merchant_name STRING,
  payment_type STRING NOT NULL,
  typical_amount_cents BIGINT NOT NULL,
  amount_variance_cents BIGINT,
  frequency STRING NOT NULL,
  typical_day INT,
  day_variance INT,
  first_occurrence_date DATE,
  last_occurrence_date DATE,
  next_expected_date DATE,
  occurrence_count INT NOT NULL,
  missed_count INT NOT NULL,
  status STRING NOT NULL,
  confidence_score INT NOT NULL,
  category_name STRING,
  is_essential BOOLEAN NOT NULL,
  annual_cost_cents BIGINT,
  detection_method STRING NOT NULL
);
