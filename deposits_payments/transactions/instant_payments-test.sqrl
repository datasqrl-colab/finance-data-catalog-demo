    'path' = '${DATA_PATH}/instant_payments-request_for_payment.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Request_For_Payment_schema;

CREATE TABLE Instant_Payment_Return (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/instant_payments-instant_payment_return.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Instant_Payment_Return_schema;
