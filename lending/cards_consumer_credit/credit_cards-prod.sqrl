-- ## Credit Cards - Production
--
-- Ingests source data from Kafka

IMPORT credit_cards.*;

CREATE TABLE Credit_Card_Account (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_CREDIT_CARD_ACCOUNT}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Credit_Card_Account_schema;

CREATE TABLE Credit_Card (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) METADATA FROM 'timestamp',
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '30' SECOND
) WITH (
    'connector' = 'kafka',
    'properties.bootstrap.servers' = '${LENDING_KAFKA_BROKERS}',
    'properties.group.id' = '${DEPLOYMENT_ID}',
    'topic' = '${TOPIC_CREDIT_CARD}',
    'scan.startup.mode' = 'earliest-offset',
{{#is_batch}}
    'scan.bounded.mode' = 'latest-offset',
{{/is_batch}}
    'value.format' = 'json',
    'value.json.timestamp-format.standard' = 'ISO-8601'
) LIKE Credit_Card_schema;

