-- ## Mortgage Originations - Test Data
--
-- Use local filesystem data for testing

IMPORT mortgage_originations.*;

CREATE TABLE _Mortgage_Application_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_originations-mortgage_application.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Mortgage_Application_schema;

Mortgage_Application := SELECT * FROM _Mortgage_Application_input WHERE application_id <> '';

CREATE TABLE _Mortgage_Loan_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
