{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Mortgage_Loan_schema;

Mortgage_Loan := SELECT * FROM _Mortgage_Loan_input WHERE loan_id <> '';

