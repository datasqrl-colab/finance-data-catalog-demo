-- ## Mortgage Servicing - Test Data
--
-- Use local filesystem data for testing

IMPORT mortgage_servicing.*;

CREATE TABLE Mortgage_Payment (
  /** Ingestion timestamp computed at read time */
  ingestion_time AS now(),
  WATERMARK FOR ingestion_time AS ingestion_time - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_servicing-mortgage_payment.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Mortgage_Payment_schema;

