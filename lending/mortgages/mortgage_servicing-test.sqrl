-- ## Mortgage Servicing - Test Data
--
-- Use local filesystem data for testing

IMPORT mortgage_servicing.*;

CREATE TABLE _Mortgage_Payment_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
  WATERMARK FOR ingested_at AS ingested_at - INTERVAL '10' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_servicing-mortgage_payment.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Mortgage_Payment_schema;

Mortgage_Payment := SELECT * FROM _Mortgage_Payment_input WHERE payment_id <> '';

CREATE TABLE _Escrow_Account_input (
  /** Timestamp when record was ingested into the data platform */
  ingested_at TIMESTAMP_LTZ(3) NOT NULL,
