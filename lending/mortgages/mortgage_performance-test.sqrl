-- ## Mortgage Performance - Test Data
--
-- Use local filesystem data for testing

IMPORT mortgage_performance.*;

CREATE TABLE _Loan_Performance_Monthly_input (
  /** Timestamp when snapshot was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_performance-loan_performance_monthly.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Loan_Performance_Monthly_schema;

Loan_Performance_Monthly := SELECT * FROM _Loan_Performance_Monthly_input WHERE loan_id <> '';

CREATE TABLE _Prepayment_Signal_input (
  /** Timestamp when signal was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_performance-prepayment_signal.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Prepayment_Signal_schema;

Prepayment_Signal := SELECT * FROM _Prepayment_Signal_input WHERE loan_id <> '';

CREATE TABLE _Vintage_Performance_input (
  /** Timestamp when vintage analysis was computed */
  computed_at TIMESTAMP_LTZ(3) NOT NULL
) WITH (
    'connector' = 'filesystem',
    'path' = '${DATA_PATH}/mortgage_performance-vintage_performance.jsonl',
{{^is_batch}}
    'source.monitor-interval' = '10 min',
{{/is_batch}}
    'format' = 'json',
    'json.timestamp-format.standard' = 'ISO-8601'
) LIKE Vintage_Performance_schema;

Vintage_Performance := SELECT * FROM _Vintage_Performance_input WHERE vintage_id <> '';
