IMPORT customer.customer_ontology.*;
IMPORT lending.lending-ontology.*;
IMPORT deposits_payments.deposits_payments-ontology.*;

-- =====================================================
-- Customer to Credit Card Relationships
-- =====================================================

/** Credit card accounts where customer is the primary account holder */
Customer.credit_card_accounts := SELECT * FROM Credit_Card_Account a WHERE this.customer_id = a.primary_customer_id;

/** Open credit card accounts for this customer */
Customer.open_credit_card_accounts := SELECT * FROM Credit_Card_Account a WHERE this.customer_id = a.primary_customer_id
                                                                      AND account_status = 'OPEN';

/** Credit cards where customer is the cardholder (including authorized user cards) */
Customer.credit_cards := SELECT * FROM Credit_Card c WHERE this.customer_id = c.cardholder_customer_id;

/** Card delinquency events for this customer */
Customer.card_delinquency_events := SELECT * FROM Card_Delinquency_Event d WHERE this.customer_id = d.customer_id
                                                                       ORDER BY event_date DESC;

-- =====================================================
-- Customer to Consumer Loan Relationships
-- =====================================================

/** Personal loans where customer is the primary borrower */
Customer.personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;

/** Active personal loans for this customer */
Customer.active_personal_loans := SELECT * FROM Personal_Loan l WHERE this.customer_id = l.primary_borrower_customer_id
                                                            AND loan_status = 'ACTIVE';

/** Auto loans where customer is the primary borrower */
Customer.auto_loans := SELECT * FROM Auto_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;

/** Active auto loans for this customer */
Customer.active_auto_loans := SELECT * FROM Auto_Loan l WHERE this.customer_id = l.primary_borrower_customer_id
                                                    AND loan_status = 'ACTIVE';

/** Loan applications where customer is the primary applicant */
Customer.loan_applications := SELECT * FROM Loan_Application a WHERE this.customer_id = a.primary_applicant_customer_id
                                                           ORDER BY submitted_at DESC;

/** Loan applications where customer is a co-applicant */
Customer.loan_applications_as_coapplicant := SELECT * FROM Loan_Application a WHERE this.customer_id = a.co_applicant_customer_id
                                                                          ORDER BY submitted_at DESC;

/** Consumer loan delinquency events for this customer */
Customer.consumer_loan_delinquency_events := SELECT * FROM Consumer_Loan_Delinquency_Event d WHERE this.customer_id = d.customer_id
                                                                                         ORDER BY event_date DESC;

-- =====================================================
-- Customer to Mortgage Relationships
-- =====================================================

/** Mortgage applications where customer is the primary borrower */
Customer.mortgage_applications := SELECT * FROM Mortgage_Application a WHERE this.customer_id = a.primary_borrower_customer_id
                                                                   ORDER BY submitted_at DESC;

/** Mortgage loans where customer is the primary borrower */
Customer.mortgage_loans := SELECT * FROM Mortgage_Loan l WHERE this.customer_id = l.primary_borrower_customer_id;

/** Active mortgage loans for this customer */
Customer.active_mortgage_loans := SELECT * FROM Mortgage_Loan l WHERE this.customer_id = l.primary_borrower_customer_id
                                                            AND loan_status = 'ACTIVE';

/** All mortgages where customer is a borrower (primary, co-borrower, or guarantor) */
Customer.mortgage_borrower_records := SELECT * FROM Mortgage_Borrower b WHERE this.customer_id = b.customer_id;

/** Mortgage delinquency events for this customer */
Customer.mortgage_delinquency_events := SELECT * FROM Delinquency_Event d WHERE this.customer_id = d.customer_id
                                                                      ORDER BY event_date DESC;

/** Mortgage loan modifications for this customer */
Customer.mortgage_modifications := SELECT * FROM Loan_Modification m WHERE this.customer_id = m.customer_id
                                                                 ORDER BY request_date DESC;

-- =====================================================
-- Test Queries — verify import chain and test data
-- =====================================================

/*+test */
Catalog_Account_Test := SELECT account_id, account_type, account_status
                        FROM Account WHERE account_id = 'ACC-001'
                        ORDER BY account_id;

/*+test */
Catalog_Transaction_Test := SELECT transaction_id, transaction_category, amount_cents
                            FROM Transaction WHERE transaction_id = 'TXN-001'
                            ORDER BY transaction_id;

/*+test */
Catalog_Card_Authorization_Test := SELECT authorization_id, authorization_status, merchant_name
                                   FROM Card_Authorization WHERE authorization_id = 'AUTH-001'
                                   ORDER BY authorization_id;

/*+test */
Catalog_Ach_Transaction_Test := SELECT ach_transaction_id, direction, amount_cents
                                FROM Ach_Transaction WHERE ach_transaction_id = 'ACH-001'
                                ORDER BY ach_transaction_id;

/*+test */
Catalog_Wire_Transfer_Test := SELECT wire_transfer_id, wire_type, amount_cents
                              FROM Wire_Transfer WHERE wire_transfer_id = 'WIRE-001'
                              ORDER BY wire_transfer_id;

/*+test */
Catalog_Unified_Transaction_Test := SELECT transaction_id, transaction_source, debit_credit
                                    FROM Unified_Transaction WHERE transaction_id = 'TXN-001'
                                    ORDER BY transaction_id;

/*+test */
Catalog_Account_Product_Test := SELECT product_code, product_name, product_category
                                FROM Account_Product WHERE product_code = 'PROD-CHK-001'
                                ORDER BY product_code;

-- Customer Domain Test Queries

/*+test */
Catalog_Customer_Test := SELECT customer_id, customer_type, customer_status
                         FROM Customer WHERE customer_id = 'CUST-001'
                         ORDER BY customer_id;

/*+test */
Catalog_Kyc_Verification_Test := SELECT verification_id, customer_id, verification_type, verification_result
                                  FROM Kyc_Verification WHERE verification_id = 'KYC-001'
                                  ORDER BY verification_id;

-- Lending Domain Test Queries

/*+test */
Catalog_Credit_Card_Account_Test := SELECT credit_card_account_id, account_status, credit_limit_cents
                                     FROM Credit_Card_Account WHERE credit_card_account_id = 'CCA-001'
                                     ORDER BY credit_card_account_id;

/*+test */
Catalog_Personal_Loan_Test := SELECT loan_id, loan_status, original_amount_cents
                               FROM Personal_Loan WHERE loan_id = 'PL-001'
                               ORDER BY loan_id;

/*+test */
Catalog_Mortgage_Loan_Test := SELECT loan_id, loan_status, original_principal_cents
                               FROM Mortgage_Loan WHERE loan_id = 'ML-001'
                               ORDER BY loan_id;