{
  "version": "1",
  "enabled-engines": ["flink", "postgres", "vertx"],
  "script": {
    "main": "ontology.sqrl"
  },
  "engines": {
    "flink": {
      "config": {
        "execution.runtime-mode": "STREAMING",
        "table.exec.source.idle-timeout": "30 s"
      }
    }
  },
  "compiler": {
    "predicate-pushdown-rules": "LIMITED_RULES",
    "api": {
      "protocols": ["GRAPHQL", "REST", "MCP"],
      "endpoints": "FULL",
      "max-result-depth": 1,
      "add-prefix": true
    }
  }
}
